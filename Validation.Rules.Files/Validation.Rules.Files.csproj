<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>
            A powerful, intuitive collection of custom validation attributes built directly on top of the standard .NET
            System.ComponentModel.DataAnnotations infrastructure.
        </Description>
        <PackageTags>zhomfr; validation; validation rules; rules; files; csharp; dotnet;</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Helpers.SmartFile\Helpers.SmartFile.csproj"/>
        <ProjectReference Include="..\Validation.Rules.Abstractions\Validation.Rules.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="4.153.1"/>

        <!-- Підтягується лише на Windows -->
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" Condition="$([MSBuild]::IsOSPlatform('Windows'))"/>

        <!-- Підтягується лише на Linux (наприклад, у GitHub Actions) -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" Condition="$([MSBuild]::IsOSPlatform('Linux'))"/>

        <!-- Підтягується лише на macOS -->
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.153.1" Condition="$([MSBuild]::IsOSPlatform('OSX'))"/>

        <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.402">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Update="MinVer" Version="8.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
