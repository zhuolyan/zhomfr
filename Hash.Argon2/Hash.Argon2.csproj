<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>Argon Hash Driver</Title>
        <Description>
            This library provides an Argon2 implementation of the `Zhomfr.Hash.Abstractions` hashing contract.
        </Description>
        <PackageTags>zhomfr; hash; security; argon2;</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Hash.Abstractions\Hash.Abstractions.csproj"/>
        <ProjectReference Include="..\Validation.Rules\Validation.Rules.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1"/>
        <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Update="MinVer" Version="8.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
