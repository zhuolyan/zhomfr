<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>Validation Rules for Database</Title>
        <Description>
            A powerful, intuitive collection of custom validation attributes built directly on top of the standard .NET
            System.ComponentModel.DataAnnotations infrastructure.
        </Description>
        <PackageTags>zhomfr; validation; validation rules; rules; database; csharp; dotnet;</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Validation.Rules.Abstractions\Validation.Rules.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13"/>
        <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.402">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Update="MinVer" Version="8.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
